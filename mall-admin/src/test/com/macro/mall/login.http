### 第一步：登录获取 Token
# @name login
POST http://localhost:8080/demo/login
Content-Type: application/json

{
  "username": "admin",
  "password": "123456"
}

> {%
    if (response.status === 200) {
        // 【核心修改】这里要用 response.body.data，只取那一长串 Token
        client.global.set("auth_token", response.body.data);
        client.log("Token 抓取成功！");
    } else {
        client.log("登录失败：" + response.status);
    }
%}